__DOMAIN__ {
    encode gzip

    # The room server owns the WebSocket endpoint and liveness probe only.
    @server path /play /healthz
    reverse_proxy @server 127.0.0.1:8765

    # Everything else is the published static site and release catalog.
    root * /srv/saga2d-site/current

    # Invitation links carry the game id and room code in the path.
    @invite path /join/*
    rewrite @invite /join/index.html

    header {
        Cache-Control "public, max-age=300"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    handle_errors {
        @notfound expression {http.error.status_code} == 404
        rewrite @notfound /404.html
        file_server
    }
    file_server
}
