__DOMAIN__ {
    encode gzip

    # Compatibility comes from the running process, never the static website.
    @server path /play /healthz /server-compatibility.json
    reverse_proxy @server 127.0.0.1:8765 {
        header_down Cache-Control "no-store"
    }

    # Everything else is the published static site and release catalog.
    root * /srv/saga2d-site/current

    # Invitation links carry the game id and room code in the path.
    @invite path /join/*
    rewrite @invite /join/index.html

    @static not path /play /healthz /server-compatibility.json
    header @static Cache-Control "public, max-age=300"
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    handle_errors {
        @notfound expression {http.error.status_code} == 404
        rewrite @notfound /404.html
        file_server
    }
    file_server
}
